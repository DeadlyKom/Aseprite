# Локальный рабочий архив любого плагина: эксперименты, отчёты и копии рисунков.
work/

# Кеши и локальные зависимости вспомогательных инструментов.
.cache/
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
venv/
node_modules/

# Временные файлы, журналы и резервные копии редакторов.
*.tmp
*.log
*.bak
*.swp
*.swo
*~

# Служебные файлы операционных систем.
.DS_Store
Thumbs.db
Desktop.ini

# outputs/, исходники, документация, tests/ и ресурсы плагинов не исключаются.
# В частности, *.aseprite, изображения и *.aseprite-extension не игнорируются глобально.
